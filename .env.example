# KeiGent model endpoint config
# Required secret. Use the key for whichever OpenAI-compatible or Anthropic-compatible endpoint you configure.
KEIGENT_API_KEY=sk-xxx

# Protocol shape. Supported values: openai | anthropic
KEIGENT_API_PROTOCOL=openai

# Optional custom endpoint URL.
# OpenAI-compatible default: https://api.openai.com/v1
# Anthropic-compatible default: https://api.anthropic.com
# KEIGENT_BASE_URL=https://api.openai.com/v1

# Optional model id override.
# KEIGENT_MODEL_ID=gpt-4o-mini
