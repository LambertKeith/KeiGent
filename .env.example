# KeiGent 密钥配置
# 仅用于开发环境和 CI 注入密钥，非密钥配置请在 ~/.keigent/config.json 中设置（参考 config.example.json）。
# 环境变量优先级高于 ~/.keigent/config.json。
KEIGENT_API_KEY=

# 可选：openai | anthropic。空值不会覆盖 config.json。
KEIGENT_API_PROTOCOL=

# 可选：自定义兼容端点，例如 OpenAI-compatible 默认 https://api.openai.com/v1。
KEIGENT_BASE_URL=

# 可选：模型 ID。
KEIGENT_MODEL_ID=
