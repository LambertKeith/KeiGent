{
  "name": "@keigent/cli",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "keigent": "./bin/keigent.mjs"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.77.0",
    "@keigent/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
